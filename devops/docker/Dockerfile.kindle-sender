# syntax=docker/dockerfile:1

FROM rust:1.97.1-bullseye AS builder

RUN apt-get update \
    && apt-get install -y --no-install-recommends cmake perl pkg-config \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

COPY Cargo.toml Cargo.lock ./
COPY src ./src

RUN cargo build \
    --locked \
    --release \
    --bin kindle-sender \
    --target x86_64-unknown-linux-gnu

RUN strip /build/target/x86_64-unknown-linux-gnu/release/kindle-sender

FROM scratch AS artifact

COPY --from=builder /build/target/x86_64-unknown-linux-gnu/release/kindle-sender /kindle-sender
